# ============================================================
# Secrets template — copy to `.env` and fill real values.
# `.env` is gitignored. NEVER put real values in this file.
# ============================================================

# --- Groq key pool (comma-separated, enables failover) ---
# Create keys at console.groq.com -> API Keys. One key works; 2+ enables failover.
GROQ_API_KEYS=REPLACE_WITH_GROQ_KEY_1,REPLACE_WITH_GROQ_KEY_2

# --- Telegram (monitoring) ---
# Create via @BotFather -> /newbot -> token. Chat ID: message the bot, then
# GET https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID

# --- YouTube Data API v3 (one-time OAuth helper) ---
# Generate with: python -m app youtube-oauth
YOUTUBE_CLIENT_ID=REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
YOUTUBE_REFRESH_TOKEN=REPLACE_WITH_REFRESH_TOKEN

# --- Behavior flags ---
DRY_RUN=false
LOG_LEVEL=INFO
